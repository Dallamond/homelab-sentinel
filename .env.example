# Copia este archivo a .env y ajusta lo que necesites.
# Nada de esto es obligatorio para arrancar: por defecto todo llega
# desactivado hasta que actives fuentes desde el dashboard.

ROLE=standalone
HOST_NAME=minipc

# --- Base de datos ---
# SQLite (por defecto, cero configuración):
DATABASE_URL=sqlite+aiosqlite:////app/data/sentinel.db
# Postgres (si algún día quieres escalar):
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel

# --- Filtros de fuentes ---
# Si se dejan vacías, se vigilan TODAS las fuentes descubiertas (recomendado para empezar).
# Si se rellenan, solo se vigilan las que aparezcan aquí.
# JOURNALD_UNITS=immich.service sshd.service
# DOCKER_CONTAINERS=immich omv-web

# --- Seguridad entre agente(s) y servidor ---
AGENT_API_KEY=cambia-esto-por-algo-largo-y-aleatorio

# --- Telegram (opcional) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email / Gmail (opcional) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_16_caracteres
EMAIL_FROM=tu_correo@gmail.com
EMAIL_TO=tu_correo@gmail.com

# --- Resúmenes inteligentes (LLM) ---
# gemini | ollama | openai_compat | none
SUMMARIZER_BACKEND=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Si prefieres Ollama en tu PC personal (ajusta la IP):
# SUMMARIZER_BACKEND=ollama
# OLLAMA_BASE_URL=http://192.168.1.50:11434
# OLLAMA_MODEL=llama3.1

WEEKLY_SUMMARY_CRON=0 8 * * MON
MONTHLY_SUMMARY_CRON=0 8 1 * *

# --- Seguridad del dashboard ---
# Por defecto está abierto (apto para LAN de confianza).
# Si rellenas esto, el frontend pedirá la clave la primera vez que cargues.
# DASHBOARD_API_KEY=cambia-esto-por-algo-largo-y-aleatorio

# --- Rate limiting del LLM ---
# Cuántas llamadas a /api/explain puede hacer cada IP por ventana (1 hora por defecto).
LLM_RATE_LIMIT_EXPLAIN=20
LLM_RATE_LIMIT_SUMMARY=6
LLM_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Agente (solo role=agent) ---
# SERVER_URL=http://192.168.1.100:8088
AGENT_PUSH_INTERVAL_SECONDS=5
AGENT_DISCOVERY_INTERVAL_SECONDS=60
AGENT_PUSH_MAX_BUFFER=5000
